# Copy to .env and fill in. Never commit .env (see .gitignore).

# --- Database (required) ---
# Local MongoDB or a MongoDB Atlas connection string.
MONGODB_URI=mongodb://127.0.0.1:27017/dishdash

# --- adapter-node runtime (required in production / behind a proxy) ---
# Full public URL of the app. Needed by SvelteKit for CSRF / form-action
# origin checks when running behind a proxy (e.g. on Render).
# ORIGIN=https://dishdash-qr.onrender.com
# HOST=0.0.0.0
# PORT=3000

# --- Initial superuser bootstrap (used by scripts/create-superuser.mjs) ---
# The first superuser is provisioned out-of-band; there is no registration.
SUPERUSER_USERNAME=superadmin
SUPERUSER_PASSWORD=change-me-please

# --- Seed (scripts/seed.mjs) ---
# Shared demo password for the seeded gestore/lavoratore accounts.
DEMO_PASSWORD=password
