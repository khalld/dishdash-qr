# Copy to .env and fill in. Never commit .env (see .gitignore).

# --- Database (required) ---
# Local MongoDB or a MongoDB Atlas connection string.
MONGODB_URI=mongodb://127.0.0.1:27017/dishdash

# --- adapter-node runtime (required in production / behind a proxy) ---
# Full public URL of the app. Needed by SvelteKit for CSRF / form-action
# origin checks when running behind a proxy (e.g. on Render).
# ORIGIN=https://dishdash-qr.onrender.com
# HOST=0.0.0.0
# PORT=3000

# --- Initial staff bootstrap (used by scripts/create-superuser.mjs) ---
# Staff accounts are provisioned out-of-band; there is no registration.
# All passwords are required (min 8 chars). Usernames are optional (defaults shown).
SUPERUSER_USERNAME=superadmin
SUPERUSER_PASSWORD=change-me-please
GESTORE_USERNAME=gestore
GESTORE_PASSWORD=change-me-please
LAVORATORE_USERNAME=lavoratore
LAVORATORE_PASSWORD=change-me-please
# Tenant the gestore/lavoratore are attached to (default "Pub del Centro").
# create-superuser bootstraps this tenant if it is missing — no need to create
# it beforehand. (`npm run seed` always uses "Pub del Centro".)
BOOTSTRAP_TENANT_NAME=Pub del Centro

# --- Seed (scripts/seed.mjs) ---
# Shared demo password for the seeded gestore/lavoratore accounts.
DEMO_PASSWORD=password
